[Unit]
Description=Noticeboard Backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# This is a template example. Run scripts/install_pi.sh to generate a service
# with the correct user and absolute project path for your Raspberry Pi.
User=__NOTICEBOARD_USER__
WorkingDirectory=__NOTICEBOARD_APP_DIR__/backend
Environment=NOTICEBOARD_HOST=0.0.0.0
Environment=NOTICEBOARD_PORT=5000
Environment=NOTICEBOARD_SYSTEMCTL=/usr/bin/systemctl
Environment=NOTICEBOARD_DISPLAY_SERVICE=noticeboard-display.service
ExecStart=/usr/bin/python3 __NOTICEBOARD_APP_DIR__/backend/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
